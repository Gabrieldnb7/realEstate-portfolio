# Dependências
node_modules/

# Build de produção
dist/

# Variáveis de ambiente
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cobertura de testes (Vitest)
coverage/

# IDEs e Editores
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Arquivos de sistema
.DS_Store
Thumbs.db
desktop.ini

# Banco de dados SQLite gerado (criado por npm run migrar)
dados/*.sqlite
dados/*.sqlite-shm
dados/*.sqlite-wal

# Uploads de fotos (gerados por npm run semear:teste)
uploads/

# Anotações e arquivos temporários da bancada de desenvolvimento
.tmp/
