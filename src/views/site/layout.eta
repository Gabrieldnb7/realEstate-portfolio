<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= it.tituloPagina %> · Portfólio imobiliário +55Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..400&amp;family=Instrument+Sans:wght@400..600&amp;display=swap"
    />
    <link rel="stylesheet" href="/css/tokens.css" />
    <link rel="stylesheet" href="/css/estilos.css" />
  </head>
  <body>
    <header class="topo">
      <p class="marca">+55Hub Corporate Group</p>
      <nav class="menu" aria-label="Páginas do site">
        <a href="/">Início</a>
        <a href="/imoveis">Imóveis</a>
        <a href="/admin">Painel</a>
      </nav>
    </header>

    <main>
      <%~ it.body %>
    </main>

    <footer class="rodape">
      <% if (it.rodape.texto) { %><p><%= it.rodape.texto %></p><% } %>
      <p>Fale com a equipe: <a href="mailto:consultoria@realestate.example">consultoria@realestate.example</a></p>
      <p class="aviso"><%= it.aviso %></p>
    </footer>
  </body>
</html>
