<section class="indicadores" aria-label="Indicadores do catálogo">
  <ul class="indicadores-lista">
    <li class="indicador indicador-total">
      <span class="indicador-marca"></span>
      <div class="indicador-dados">
        <p class="indicador-rotulo">Imóveis listados</p>
        <p class="indicador-valor"><%= it.indicadores.total %></p>
      </div>
    </li>
    <li class="indicador indicador-publicados">
      <span class="indicador-marca"></span>
      <div class="indicador-dados">
        <p class="indicador-rotulo">Publicados</p>
        <p class="indicador-valor"><%= it.indicadores.publicados %></p>
      </div>
    </li>
    <li class="indicador indicador-rascunhos">
      <span class="indicador-marca"></span>
      <div class="indicador-dados">
        <p class="indicador-rotulo">Em rascunho</p>
        <p class="indicador-valor"><%= it.indicadores.rascunhos %></p>
      </div>
    </li>
    <li class="indicador indicador-fora">
      <span class="indicador-marca"></span>
      <div class="indicador-dados">
        <p class="indicador-rotulo">Fora do ar</p>
        <p class="indicador-valor"><%= it.indicadores.foraDoAr %></p>
      </div>
    </li>
  </ul>
</section>

<section class="detalhamento" aria-label="Detalhamento dos imóveis">
  <header class="cabecalho-bloco">
    <div>
      <h2 class="cabecalho-titulo">Detalhamento dos imóveis</h2>
      <p class="cabecalho-subtitulo">Cada linha abre a edição e permite excluir o registro.</p>
    </div>

    <form class="campo-busca" method="get" action="/admin">
      <label class="campo-busca-label" for="busca">Buscar por referência, título, cidade ou bairro</label>
      <input id="busca" name="busca" type="search" value="<%= it.busca %>" placeholder="BR-0101" />
      <% if (it.situacaoAtiva) { %><input type="hidden" name="situacao" value="<%= it.situacaoAtiva %>" /><% } %>
      <% if (it.paisAtivo) { %><input type="hidden" name="pais" value="<%= it.paisAtivo %>" /><% } %>
      <% if (it.tipologiaAtiva) { %><input type="hidden" name="tipologia" value="<%= it.tipologiaAtiva %>" /><% } %>
      <button class="botao botao-primario" type="submit">Buscar</button>
    </form>
  </header>

  <% if (it.linhas.length === 0) { %>
    <div class="estado-vazio">
      <p class="estado-vazio-titulo">
        <% if (it.total === 0) { %>
          Nenhum imóvel cadastrado
        <% } else { %>
          Nenhum imóvel atende aos filtros
        <% } %>
      </p>
      <p>
        <% if (it.total === 0) { %>
          Comece por Novo imóvel.
        <% } else { %>
          <a href="<%= it.urlLimparFiltros %>">Limpar filtros</a> para ver a lista inteira.
        <% } %>
      </p>
    </div>
  <% } else { %>
    <div class="corpo-tabela">
      <table class="tabela">
        <thead>
          <tr>
            <th scope="col">Referência</th>
            <th scope="col">Imóvel</th>
            <th scope="col">Praça</th>
            <th scope="col">Preço</th>
            <th scope="col" class="coluna-num">Fotos</th>
            <th scope="col">Situação</th>
            <th scope="col">Atualizado</th>
            <th scope="col">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% it.linhas.forEach(function (imovel) { %>
            <tr>
              <td class="celula-ref"><%= imovel.ref %></td>
              <td>
                <strong><%= imovel.titulo %></strong>
                <span class="selo selo-tipologia"><%= imovel.tipologia %></span>
                <p class="ajuda"><%= imovel.cidade %> / <%= imovel.bairro %></p>
              </td>
              <td><%= imovel.pais %></td>
              <td class="coluna-num"><%= imovel.preco %></td>
              <td class="coluna-num">
                <%= imovel.totalFotos %>
                <% if (imovel.fotosSemDescricao > 0) { %>
                  <span class="selo selo-alerta"><%= imovel.fotosSemDescricao %> sem descrição</span>
                <% } %>
              </td>
              <td>
                <span class="selo selo-situacao situacao-<%= imovel.situacao %>">
                  <span class="ponto-situacao"></span><%= imovel.situacao %>
                </span>
              </td>
              <td><%= imovel.atualizado %></td>
              <td>
                <span class="acoes">
                  <a href="<%= imovel.urlEditar %>">Editar</a>
                  <form method="post" action="<%= imovel.urlExcluir %>">
                    <button class="botao botao-perigo" type="submit">Excluir</button>
                  </form>
                </span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>

  <footer class="rodape-bloco">
    <p>Exibindo <%= it.linhas.length %> de <%= it.total %> imóveis.</p>
  </footer>
</section>
