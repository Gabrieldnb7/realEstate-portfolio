<section class="bloco-form">
  <p class="ajuda">O texto salvo aparece no site público na hora. Gravar substitui o texto anterior.</p>
</section>

<% it.paginas.forEach(function (pagina) { %>
  <form method="post" action="<%= pagina.acao %>">
    <fieldset class="bloco-form">
      <legend><%= pagina.rotulo %></legend>

      <% pagina.campos.forEach(function (campo) { %>
        <div class="campo">
          <label for="<%= pagina.pagina %>-<%= campo.campo %>"><%= campo.rotulo %></label>
          <% if (campo.multilinha) { %>
            <textarea id="<%= pagina.pagina %>-<%= campo.campo %>" name="<%= campo.campo %>" rows="3"
              maxlength="500"><%= campo.valor %></textarea>
          <% } else { %>
            <input id="<%= pagina.pagina %>-<%= campo.campo %>" name="<%= campo.campo %>" type="text"
              maxlength="500" value="<%= campo.valor %>" />
          <% } %>
          <% if (campo.erro) { %><p class="erro-campo" role="alert"><%= campo.erro %></p><% } %>
        </div>
      <% }); %>

      <% if (pagina.pagina === 'rodape') { %>
        <p class="ajuda">
          O aviso obrigatório de projeto de avaliação técnica faz parte da página e não é editável.
        </p>
      <% } %>

      <p class="bloco-acoes"><button class="botao botao-primario" type="submit">Salvar</button></p>
    </fieldset>
  </form>
<% }); %>
